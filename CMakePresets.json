{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-pico",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NEO1_PLATFORM": "pico",
        "NEO1_PERSONALITY": "50",
        "NEO1_ENABLE_VACI": "1",
        "NEO1_ENABLE_VCFFA1": "1"
      }
    },
    {
      "name": "neo1-pico-23-full",
      "displayName": "Neo1 Pico 23 (VACI on, VCFFA1 on)",
      "description": "Neo1-23 baseline policy profile: VACI and VCFFA1 both enabled.",
      "inherits": "base-pico",
      "cacheVariables": {
        "NEO1_PERSONALITY": "23",
        "NEO1_ENABLE_VACI": "1",
        "NEO1_ENABLE_VCFFA1": "1"
      }
    },
    {
      "name": "neo1-pico-50-full",
      "displayName": "Neo1 Pico 50 (VACI on, VCFFA1 on)",
      "description": "Neo1-50 with both storage interfaces enabled.",
      "inherits": "base-pico",
      "cacheVariables": {
        "NEO1_PERSONALITY": "50",
        "NEO1_ENABLE_VACI": "1",
        "NEO1_ENABLE_VCFFA1": "1"
      }
    },
    {
      "name": "neo1-pico-50-vaci-only",
      "displayName": "Neo1 Pico 50 (VACI on, VCFFA1 off)",
      "description": "Neo1-50 profile for VACI-only testing.",
      "inherits": "base-pico",
      "cacheVariables": {
        "NEO1_PERSONALITY": "50",
        "NEO1_ENABLE_VACI": "1",
        "NEO1_ENABLE_VCFFA1": "0"
      }
    },
    {
      "name": "base-sdl",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sdl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NEO1_PLATFORM": "sdl",
        "NEO1_PERSONALITY": "50",
        "NEO1_ENABLE_VACI": "1",
        "NEO1_ENABLE_VCFFA1": "1"
      }
    },
    {
      "name": "neo1-sdl-23-full",
      "displayName": "Neo1 SDL 23 (VACI on, VCFFA1 on)",
      "description": "SDL host target with Neo1-23 policy features enabled.",
      "inherits": "base-sdl",
      "cacheVariables": {
        "NEO1_PERSONALITY": "23",
        "NEO1_ENABLE_VACI": "1",
        "NEO1_ENABLE_VCFFA1": "1"
      }
    },
    {
      "name": "neo1-sdl-50-full",
      "displayName": "Neo1 SDL 50 (VACI on, VCFFA1 on)",
      "description": "SDL host target with both storage interfaces enabled.",
      "inherits": "base-sdl",
      "cacheVariables": {
        "NEO1_PERSONALITY": "50",
        "NEO1_ENABLE_VACI": "1",
        "NEO1_ENABLE_VCFFA1": "1"
      }
    },
    {
      "name": "neo1-sdl-50-vaci-only",
      "displayName": "Neo1 SDL 50 (VACI on, VCFFA1 off)",
      "description": "SDL host target for VACI-only testing.",
      "inherits": "base-sdl",
      "cacheVariables": {
        "NEO1_PERSONALITY": "50",
        "NEO1_ENABLE_VACI": "1",
        "NEO1_ENABLE_VCFFA1": "0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build",
      "configurePreset": "neo1-pico-50-full"
    }
  ]
}
